<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.unifan.produtos.controller.ProdutoController"
            prefWidth="1180" prefHeight="720">

    <top>
        <HBox styleClass="cabecalho" alignment="CENTER_LEFT">
            <Label text="Cadastro de Produtos" styleClass="titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblArquivo" styleClass="arquivo"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ================= ABA PRODUTOS ================= -->
            <Tab text="Produtos">
                <HBox spacing="16">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <!-- Formulário -->
                    <VBox spacing="10" styleClass="painel" minWidth="360" maxWidth="360">
                        <Label text="Dados do produto" styleClass="subtitulo"/>

                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="110"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Código *" GridPane.rowIndex="0"/>
                            <TextField fx:id="txtCodigo" promptText="8 letras/números" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Nome *" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtNome" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Descrição" GridPane.rowIndex="2"/>
                            <TextArea fx:id="txtDescricao" prefRowCount="2" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Categoria *" GridPane.rowIndex="3"/>
                            <ComboBox fx:id="cbCategoria" maxWidth="Infinity" promptText="Selecione" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Fabricação *" GridPane.rowIndex="4"/>
                            <DatePicker fx:id="dpFabricacao" maxWidth="Infinity" promptText="dd/mm/aaaa" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Validade *" GridPane.rowIndex="5"/>
                            <DatePicker fx:id="dpValidade" maxWidth="Infinity" promptText="dd/mm/aaaa" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <Label text="Preço compra *" GridPane.rowIndex="6"/>
                            <TextField fx:id="txtPrecoCompra" promptText="0,00" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                            <Label text="Preço venda *" GridPane.rowIndex="7"/>
                            <TextField fx:id="txtPrecoVenda" promptText="0,00" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                            <Label text="Estoque *" GridPane.rowIndex="8"/>
                            <TextField fx:id="txtEstoque" promptText="0" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                        </GridPane>

                        <HBox spacing="8">
                            <Button text="Cadastrar" onAction="#onCadastrar" defaultButton="true" styleClass="primario" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="Limpar" onAction="#onLimpar" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Consulta + tabela -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Consultar por código:"/>
                            <TextField fx:id="txtConsulta" promptText="Ex.: LAT00001" onAction="#onConsultar" prefWidth="160"/>
                            <Button text="Consultar" onAction="#onConsultar"/>
                            <Button text="Listar todos" onAction="#onListarTodos"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Excluir selecionado" onAction="#onExcluir" styleClass="perigo"/>
                        </HBox>

                        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colCodigo" text="Código" prefWidth="85"/>
                                <TableColumn fx:id="colNome" text="Nome" prefWidth="170"/>
                                <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="100"/>
                                <TableColumn fx:id="colSetor" text="Setor" prefWidth="100"/>
                                <TableColumn fx:id="colFabricacao" text="Fabricação" prefWidth="85"/>
                                <TableColumn fx:id="colValidade" text="Validade" prefWidth="85"/>
                                <TableColumn fx:id="colPrecoCompra" text="Compra" prefWidth="75"/>
                                <TableColumn fx:id="colPrecoVenda" text="Venda" prefWidth="75"/>
                                <TableColumn fx:id="colEstoque" text="Estoque" prefWidth="60"/>
                            </columns>
                            <placeholder><Label text="Nenhum produto cadastrado."/></placeholder>
                        </TableView>

                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <Label text="■ Vence em até 60 dias" style="-fx-text-fill: #d9534f;"/>
                            <Label text="■ Estoque abaixo de 10" style="-fx-text-fill: #d4a017;"/>
                        </HBox>

                        <TextArea fx:id="txtDetalhes" editable="false" prefRowCount="4" wrapText="true"
                                  promptText="Selecione um produto na tabela ou consulte pelo código para ver os detalhes."/>
                    </VBox>
                </HBox>
            </Tab>

            <!-- ================= ABA RELATÓRIOS ================= -->
            <Tab text="Relatórios">
                <VBox spacing="12">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <FlowPane hgap="8" vgap="8">
                        <Button text="Próximos ao vencimento (60 dias)" onAction="#onRelatorioVencimento"/>
                        <Button text="Estoque baixo (&lt; 10)" onAction="#onRelatorioEstoqueBaixo"/>
                        <Button text="Margem média por categoria" onAction="#onRelatorioMargem"/>
                        <Button text="Agrupados por setor" onAction="#onRelatorioSetor"/>
                        <Button text="Resumo do estoque" onAction="#onRelatorioResumo"/>
                    </FlowPane>
                    <TextArea fx:id="txtRelatorio" editable="false" styleClass="relatorio" VBox.vgrow="ALWAYS"
                              promptText="Escolha um relatório acima."/>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <Label fx:id="lblStatus" styleClass="status" maxWidth="Infinity"/>
    </bottom>
</BorderPane>
