<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Aba de categorias: tem o seu próprio controlador (CategoriaController) -->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.unifan.produtos.controller.CategoriaController"
      spacing="16">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <!-- Formulário -->
    <VBox spacing="10" styleClass="painel" minWidth="360" maxWidth="360">
        <Label text="Nova categoria" styleClass="subtitulo"/>

        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="ID" GridPane.rowIndex="0"/>
            <Label text="gerado automaticamente" styleClass="dica" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Nome *" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNome" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Descrição" GridPane.rowIndex="2"/>
            <TextArea fx:id="txtDescricao" prefRowCount="2" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Setor *" GridPane.rowIndex="3"/>
            <ComboBox fx:id="cbSetor" editable="true" maxWidth="Infinity" promptText="Escolha ou digite"
                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing="8">
            <Button text="Cadastrar" onAction="#onCadastrar" styleClass="primario" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Limpar" onAction="#onLimpar" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <!-- Consulta + tabela -->
    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Consultar por ID:"/>
            <TextField fx:id="txtConsulta" promptText="Ex.: 3" onAction="#onConsultar" prefWidth="100"/>
            <Button text="Consultar" onAction="#onConsultar"/>
            <Button text="Listar todas" onAction="#onListarTodas"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Excluir selecionada" onAction="#onExcluir" styleClass="perigo"/>
        </HBox>

        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colNome" text="Nome" prefWidth="150"/>
                <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="260"/>
                <TableColumn fx:id="colSetor" text="Setor" prefWidth="140"/>
                <TableColumn fx:id="colProdutos" text="Produtos" prefWidth="80"/>
            </columns>
            <placeholder><Label text="Nenhuma categoria cadastrada."/></placeholder>
        </TableView>
    </VBox>
</HBox>
